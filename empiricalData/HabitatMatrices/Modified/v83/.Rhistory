WildBoarTab <- as.matrix(read.table("WildboarsExpStochGrowth.txt", header=TRUE, row.names=1))
# Mean
MEAN_Rows <- rowMeans(WildBoarTab)
WildBoarTab
is.numeric(WildBoarTab)
STD_Rows <- apply(WildBoarTab,1,sd)
# Variance
# The command is 'var'. Same as for std considering columns and rows.
VAR_Rows <- apply(WildBoarTab ,1,var)
StatTab <-matrix(NA, nrow=3, ncol=11)
rownames(StatTab)<-c("Mean", "Std", "Var")
colnames(StatTab)<-c("R0","R1","R2","R3","R4","R5","R6","R7","R8","R9","R10")
StatTab[1,]<-round(MEAN_Rows,1)
StatTab[2,]<-round(STD_Rows,1)
StatTab[3,]<-round(VAR_Rows,1)
write.table(StatTab, "BasicStatsWildBoars.txt")
