setwd("~/Dropbox/JONATAN_MS/data_for_anna/HabitatMatrices/Modified/v83")
mat <- read.table("v83_1.txt")
mat[mat==-9999]<-0
# plot as a grid (matrix)
image(as.matrix(mat)), col=c("white", "forestgreen")
# plot as points
p<- which(mat==1, arr.ind=TRUE)
plot(p)
# normalize to [0 1] landscape
p[,1]<-p[,1]/dim(mat)[1]
p[,2]<-p[,2]/dim(mat)[2]
# make to point pattern
p_norm<-ppp(p[,1], p[,2])
summary(p_norm)
identify(p_norm)
