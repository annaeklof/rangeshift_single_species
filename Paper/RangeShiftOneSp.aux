\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Shows dispersal kernels used in the model (colored lines) and the dispersal kernels for eight European mammal species (dotted lines): 1 -- {\em  Clethrionomys rufocanus} , 2 -- {\em  Pteromys volans}, 3 -- {\em  Rupicapra rupicapra} and {\em  Lepus europaeus} (lines are overlapping), 4 -- {\em  Rupicapra pyreica}, 5 -- {\em  Alces alces}, 6 -- {\em  Gulo gulo}, and 7 -- {\em  Ursus arctos}. \relax }}{12}}
