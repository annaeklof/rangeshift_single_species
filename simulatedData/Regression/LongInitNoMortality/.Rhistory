# A[2,2] <- -0.5
# b <- c(1,1) ## Intrinsic growth rates
# n0 <- c(1, 1) ## Initial conditions
# R2 always excludes R1 (due to differences in interspecific competition)
# Adj <- matrix(c(-1,-1,-1,-1), S, S) ## Adjacency matrix
# A <- Adj
# A[1,1] <- -0.5
# A[1,2] <- -0.3
# A[2,1] <- -1
# A[2,2] <- -0.5
# b <- c(1,1) ## Intrinsic growth rates
