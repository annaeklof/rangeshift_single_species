Sp <- 10
S <- Sp
Adj <- matrix(0,Sp,Sp)
Adj[1:5,6] <- 1
Adj[2:3,7] <- 1
Adj[4:5,8] <- 1
Adj[6:8,9] <- 1
Adj[5:8,10] <- 1
print(Adj)
pi <- 0.5
Adjacency <- Adj
A <- DFS(A=Adjacency)
if (sum(A) < sum(Adjacency)){
print("The network is not acyclic, and thus some links were removed!")
}
Adj <- A
Adj
plotTheNet(Adj)
FW <- list()
''
FW <- list()
m <- Adj
net <- constructData(network, m)
m <- getTL(m)
m <- getTL(m)
m
M <- m
S <- dim(M)[1] # number of species
M <- normalizeM(M)
if(det( diag(S)-t(M) )!=0){
FW$TL <- solve(diag(S)-t(M), rep(1, S))
} else{
## Otherwise, need to use
## I + t(M) + t(M)%*% t(M) + t(M)%*%t(M) %*% t(M) + ... to approximate
## (I - t(M))^(-1)
tmp <- diag(S)
for(i in 1:9){
tmp <- tmp  %*% t(M) + diag(S)
}
TL <- tmp %*% rep(1, S)
}
