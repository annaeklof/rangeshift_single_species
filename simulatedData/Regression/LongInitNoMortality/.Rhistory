# Part i) find parameters and run simulations to get all four possible outcomes for the two resource system: competitive exclusion of R1 by R2, competitive exclusion of R2 by R1, exclusion dependent on starting conditions, and stable coexistence
S <- 2 ## Number of species
# co-existence case
Adj <- matrix(c(-1,0,0,-1), S, S) ## Adjacency matrix
A <- Adj * matrix(runif(S*S, 0, 1), S, S) ## Random values for nonzero entries
b <- c(1,1) ## Intrinsic growth rates
n0 <- c(1, 1) ## Initial conditions
Adj <- matrix(c(-1,-1,-1,-1), S, S) ## Adjacency matrix
A <- Adj
A[1,1] <- -0.5
A[1,2] <- -1
A[2,1] <- -1
A[2,2] <- -0.05
b <- c(1,1) ## Intrinsic growth rates
n0 <- c(1, 1) ## Initial conditions
require(deSolve)  ## For solving differential equations
require(tidyverse) ## For ggplot, dplyr, and tidyr
require(cowplot) ## Useful ggplot plotting defaults
## Lotka-Volterra function (for integrating ODEs)
lotvol <- function(time, y, pars) {
return(list(y*(b+(A%*%y))))
}
# Part i) find parameters and run simulations to get all four possible outcomes for the two resource system: competitive exclusion of R1 by R2, competitive exclusion of R2 by R1, exclusion dependent on starting conditions, and stable coexistence
S <- 2 ## Number of species
# co-existence case
Adj <- matrix(c(-1,0,0,-1), S, S) ## Adjacency matrix
A <- Adj * matrix(runif(S*S, 0, 1), S, S) ## Random values for nonzero entries
b <- c(1,1) ## Intrinsic growth rates
n0 <- c(1, 1) ## Initial conditions
time <- seq(0, 100, l=1001) ## Time axis
n0 <- c(20, 20) ## Initial conditions
out <- as.data.frame(ode(func=lotvol, y=n0, times=time)) ## Solve ODEs
out <- out %>% gather(species, abundance, 2:(S+1)) ## Organize results
p <- ggplot(out) + ## Plot results
geom_line(aes(x=time, y=abundance, colour=species)) +
scale_y_continuous(limits=c(0, NA)) +
scale_colour_brewer(palette="Set1")
print(p) ## Show plot
print(out %>% filter(time==max(time))) ## Show abundances at final moment
